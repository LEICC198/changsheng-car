<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/dark_bg_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="长生车机 · Tesla 风格设置中心" android:textColor="@color/dark_text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="适配诺威达 K4001 (sp9853i) · 工厂设置密码常见 1617 / 16176699 / 8888" android:textColor="@color/dark_text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/btnSetCycleWall" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp" android:background="@drawable/bg_pill_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="切换渐变背景壁纸（6 套含深浅主题）" android:textColor="@color/dark_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/btnSetBindNav" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pill_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="绑定主导航应用（切换你安装的第三方新版高德）" android:textColor="@color/dark_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/btnSetOrigCar" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pill_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="打开「原车功能」" android:textColor="@color/dark_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/btnSetSwc" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pill_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="方控学习" android:textColor="@color/dark_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/btnSetAndroid" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pill_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="安卓原生设置（蓝牙 / 默认主屏幕 / 存储）" android:textColor="@color/dark_text_primary" android:textSize="13sp" />
        <TextView android:id="@+id/btnSetLegacyCar" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pill_outline" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:text="诺威达底层车载设置 / 工厂协议选择（密码 1617）" android:textColor="@color/dark_text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
