<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wall_glacier"
    android:orientation="vertical">

    <!-- Top Bar: Borderless Stacked Big Clock + Year + Offline Lunar + Parking Timer Pill -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/dark_bg_left"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARRIZO · 艾瑞泽"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnClockCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:31"
                android:textColor="@color/dark_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026年11月26日 星期四"
                    android:textColor="@color/dark_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLunar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="农历十月十八"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <!-- Parking Timer Pill (Green static border idle -> Running orange gradient border active!) -->
        <LinearLayout
            android:id="@+id/parkPillWrap"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_park_idle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/btnQuickPark"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="● 停车计时"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnParkHistory"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:text="记录"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnWallpaper"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="换壁纸"
            android:textColor="@color/dark_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_blue"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="设置"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Split Canvas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left 39%: Native 3D Car Stage + High-Contrast Top HUD + Floating Media -->
        <FrameLayout
            android:id="@+id/leftPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="39">

            <com.changsheng.carlauncher.Car3DStageView
                android:id="@+id/car3dStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_top_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/badgeHandbrake"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_outline"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="(P) 手刹"
                            android:textColor="@color/accent_red"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeHeadlight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_outline"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="大灯"
                            android:textColor="@color/accent_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/badgeReverse"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_outline"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="R 倒车"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KM/H · GPS"
                            android:textColor="@color/accent_blue"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                <!-- Floating Local Media Card -->
                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvMediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="离线音频 · 蓝牙音乐 / 收音机"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnMediaPrev"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_prev"
                            android:contentDescription="上一首" />

                        <ImageButton
                            android:id="@+id/btnMediaPlayPause"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_play_pause"
                            android:contentDescription="播放暂停" />

                        <ImageButton
                            android:id="@+id/btnMediaNext"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_next"
                            android:contentDescription="下一首" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Right 61%: Auto Parking Summary + ZLINK Countdown + Amap Hero + ZLINK & Settings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="61"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Auto Parking Summary Banner (Shown when car boots after power-off parking) -->
            <LinearLayout
                android:id="@+id/parkSummaryBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvParkSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本次停车已自动结算"
                    android:textColor="#4ADE80"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_pill_outline"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="知道了"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 3s ZLINK Boot Countdown Banner -->
            <LinearLayout
                android:id="@+id/countdownBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCountdownText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3 秒后自动进入 ZLINK..."
                        android:textColor="@color/dark_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCancelCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_pill_outline"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="取消"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnLaunchZlinkNow"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_blue"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="立即进入"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbCountdown"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="3000"
                    android:progress="3000" />
            </LinearLayout>

            <!-- Hero Card: Amap -->
            <LinearLayout
                android:id="@+id/amapHeroCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="本地离线导航 · 主导航入口"
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAmapTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="高德地图车机版"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnBindAmap"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill_outline"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="切换第三方高德"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBoundAmapPkg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="支持绑定 U 盘安装的第三方新版高德 APK"
                        android:textColor="@color/dark_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnLaunchAmap"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pill_blue"
                        android:gravity="center"
                        android:paddingHorizontal="26dp"
                        android:text="启动高德导航"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/zlinkCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvZlinkTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ZLINK 互联"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAutoZlink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="3秒自启 "
                            android:textColor="@color/dark_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnLaunchZlink"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_pill_blue"
                        android:gravity="center"
                        android:text="立即进入 CarPlay / ZLINK"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quickCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvQuickTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="原车协议与车机设置"
                        android:textColor="@color/dark_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnQuickOrigCar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_outline"
                            android:gravity="center"
                            android:text="原车功能"
                            android:textColor="@color/dark_text_primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnQuickSettings"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_blue"
                            android:gravity="center"
                            android:text="长生设置"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Dock with "长生车机" Brand Logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/dock_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/dockBrandBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_changsheng_logo"
                android:contentDescription="长生车机Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.12"
                android:text="长生车机"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp" />

        <ImageButton
            android:id="@+id/btnAppDrawer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_apps"
            android:contentDescription="全部应用" />

        <TextView
            android:id="@+id/btnVolDown"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btnVolUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
